# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
.env
*.env

# OS specific files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
.cursor/
*.sublime-*

# Media files (to avoid large files in repo)
*.mp4
*.mp3
*.avi
*.mkv
*.mov
*.flv
*.webm
*.wav
*.aac
*.flac
*.ogg
*.m4a

# Downloaded files
downloads/

# Cookies file (contains sensitive information)
cookies.txt

# FFmpeg executable (should be downloaded by user)
ffmpeg.exe
ffprobe.exe

# Specific files to exclude
media_util.py
run_cli.py
run_gui.py
setup.py

# PyInstaller build artifacts
dist/
build/
*.spec
!media_util_gui.spec

# Test and Lint caches
.pytest_cache/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp

# Build output (large binaries / installer artifacts)
Output/
bin/
ffplay.exe

# AI agent workflow dirs and config (local tooling only)
.agent/
.claude/
.gemini/
.specify/
CLAUDE.md

# Graphify output (generated knowledge graph, local tooling only)
graphify-out/

# Size budget (maintainer-only, not part of source)
size-budget.json

# Legacy files
gui.html
.build_venv/

# Bundled Python runtime (build output, never checked in)
runtime/

# Installer signing key - NEVER commit
tools/private_key.pem

# Linux AppImage build tools (linuxdeploy*, appimagetool*) — downloaded locally, not committed
tools/*.AppImage

# OpenWolf local context — per-machine, not for sharing
.wolf/

# AI photo-restore model weights — auto-downloaded at runtime, too large for git
# (codeformer.pth ~360 MB exceeds GitHub's 100 MB file limit). Source lives in
# core/restore.py; weights fetch to ai_packages/photo_restore/weights on first run.
/CodeFormer/

